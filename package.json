{
  "name": "sqlite-editor",
  "displayName": "sqlite-editor",
  "description": "Sqlite editor",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Arnovda1/sqlite-editor"
  },
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "sqlite-editor.dbEditor",
        "displayName": "SQLite editor",
        "selector": [
          { "filenamePattern": "*.db" },
          { "filenamePattern": "*.sqlite" },
          { "filenamePattern": "*.sqlite3" }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js && npm run build:css",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch:css": "tailwindcss -i ./src/webview/app.css -o ./dist/webview.css --watch",
    "build:css": "tailwindcss -i ./src/webview/app.css -o ./dist/webview.css",
    "package": "npm run check-types && npm run lint && node esbuild.js --production && npm run build:css",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.18",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "^1.118.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.27.3",
    "esbuild-svelte": "^0.9.5",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "codemirror": "^6.0.2",
    "sql.js": "^1.14.1",
    "svelte": "^5.55.5"
  }
}
